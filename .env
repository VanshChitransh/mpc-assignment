# Database Configuration
DATABASE_URL="postgresql://newuser:new_secure_password@localhost:5432/solana_wallet"
TEST_DATABASE_URL=postgresql://newuser:new_secure_password@localhost:5432/newdb_test

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION_HOURS=24

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
MPC_PORT_NODE_1=8081
MPC_PORT_NODE_2=8082
MPC_PORT_NODE_3=8083
INDEXER_PORT=8084

# MPC Configuration
MPC_SHARED_SECRET=your-mpc-shared-secret-change-this

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Or for devnet: https://api.devnet.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com
SOLANA_COMMITMENT=confirmed

# Yellowstone GRPC Configuration (for indexer)
YELLOWSTONE_GRPC_URL=https://ams17.rpcpool.com:443
YELLOWSTONE_GRPC_TOKEN=your-yellowstone-token-if-needed

# Jupiter API Configuration
JUPITER_API_URL=https://quote-api.jup.ag/v6
JUPITER_SWAP_URL=https://quote-api.jup.ag/v6/swap

# Logging Configuration
RUST_LOG=info
LOG_LEVEL=info

# Application Configuration
MAX_QUOTE_EXPIRY_SECONDS=300
DEFAULT_SLIPPAGE_BPS=50