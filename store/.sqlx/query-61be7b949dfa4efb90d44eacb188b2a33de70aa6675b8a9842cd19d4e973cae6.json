{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                COALESCE(b.amount, 0) as balance,\n                a.mint_address as token_mint,\n                a.symbol,\n                a.decimals\n            FROM assets a\n            LEFT JOIN balances b ON a.id = b.asset_id AND b.user_id = $1\n            ORDER BY a.symbol\n            ",
