#!/bin/bash

# MPC Load Testing Script - Part of Step 2.2
# Tests the MPC system under heavy load with 50 concurrent users

set -euo pipefail  # Exit on error, undefined variables, and pipe failures

echo "==================================="
echo "MPC Load Testing (Step 2.2)"
echo "==================================="

# Colors
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Configuration
BASE_URL="http://localhost:8001"
CONCURRENT_USERS=50
OPERATIONS_PER_USER=3
TEMP_DIR=$(mktemp -d)

# Debug mode (set DEBUG=1 to enable)
DEBUG=${DEBUG:-0}

# Function to get milliseconds (macOS compatible)
get_millis() {
    perl -MTime::HiRes=time -e 'printf "%.0f\n", time * 1000'
}

# Cleanup function
cleanup() {
    if [ -d "$TEMP_DIR" ]; then
        rm -rf "$TEMP_DIR"
    fi
}

# Trap to ensure cleanup on exit
trap cleanup EXIT INT TERM

echo ""
echo -e "${BLUE}Configuration:${NC}"
echo "- Base URL: $BASE_URL"
echo "- Concurrent users: $CONCURRENT_USERS"
echo "- Operations per user: $OPERATIONS_PER_USER"
echo "- Total operations: $((CONCURRENT_USERS * OPERATIONS_PER_USER))"
echo "- Temp directory: $TEMP_DIR"
if [ "$DEBUG" -eq 1 ]; then
    echo -e "${YELLOW}- Debug mode: ENABLED${NC}"
fi

# Ensure MPC cluster is running
echo ""
echo -e "${BLUE}Checking MPC cluster health...${NC}"
HEALTH_CHECK=$(curl -s -f "$BASE_URL/health" 2>/dev/null || echo "")
if [ -z "$HEALTH_CHECK" ] || ! echo "$HEALTH_CHECK" | grep -q "healthy"; then
    echo -e "${RED}❌ MPC cluster is not running or not healthy.${NC}"
    echo "Start it first with:"
    echo "  cd mpc && cargo run"
    echo "Or use the cluster startup script."
    exit 1
fi
echo -e "${GREEN}✅ MPC cluster is running and healthy${NC}"

# Function to perform operations for a single user
user_operations() {
    local user_num=$1
    local user_id=$(printf "550e8400-e29b-41d4-a716-4466554%05d" "$user_num")
    local results_file="$TEMP_DIR/user_${user_num}.result"
    local debug_file="$TEMP_DIR/user_${user_num}.debug"
    
    # Track timing
    local start_time=$(get_millis)
    local success=1
    local error_msg=""
    
    # Operation 1: Generate key
    local gen_response=$(curl -s -w "\n%{http_code}" -X POST "$BASE_URL/generate" \
        -H "Content-Type: application/json" \
        -d "{\"user_id\":\"$user_id\",\"threshold\":2,\"total_parties\":3}" 2>/dev/null || echo -e "\n000")
    
    local gen_body=$(echo "$gen_response" | sed $d)
    local gen_code=$(echo "$gen_response" | tail -n 1)
    
    # Improved validation: check for 200 status and valid JSON response
    # Accept responses with either "success":true OR presence of key fields
    if [ "$gen_code" != "200" ]; then
        success=0
        error_msg="Key generation failed (HTTP $gen_code)"
        if [ "$DEBUG" -eq 1 ]; then
            echo "=== DEBUG: User $user_num Key Generation Failed ===" >> "$debug_file"
            echo "HTTP Code: $gen_code" >> "$debug_file"
            echo "Response Body: $gen_body" >> "$debug_file"
        fi
    elif ! (echo "$gen_body" | grep -q '"success":true' || \
            echo "$gen_body" | grep -q '"public_key"' || \
            echo "$gen_body" | grep -q '"key_share"' || \
            echo "$gen_body" | grep -q '"threshold_pubkey"' || \
            echo "$gen_body" | grep -q '"user_id"'); then
        success=0
        error_msg="Key generation returned invalid JSON (HTTP 200)"
        if [ "$DEBUG" -eq 1 ]; then
            echo "=== DEBUG: User $user_num Invalid JSON Response ===" >> "$debug_file"
            echo "HTTP Code: $gen_code" >> "$debug_file"
            echo "Response Body: $gen_body" >> "$debug_file"
        fi
    fi
    
    # Only continue if first operation succeeded
    if [ "$success" -eq 1 ]; then
        # Small delay to allow cluster to process
        sleep 0.1
        
        # Operation 2: Aggregate keys
        local agg_response=$(curl -s -w "\n%{http_code}" -X POST "$BASE_URL/aggregate-keys" \
            -H "Content-Type: application/json" \
            -d "{\"user_id\":\"$user_id\"}" 2>/dev/null || echo -e "\n000")
        
        local agg_body=$(echo "$agg_response" | sed $d)
        local agg_code=$(echo "$agg_response" | tail -n 1)
        
        if [ "$agg_code" != "200" ]; then
            success=0
            error_msg="Key aggregation failed (HTTP $agg_code)"
            if [ "$DEBUG" -eq 1 ]; then
                echo "=== DEBUG: User $user_num Aggregation Failed ===" >> "$debug_file"
                echo "HTTP Code: $agg_code" >> "$debug_file"
                echo "Response Body: $agg_body" >> "$debug_file"
            fi
        elif ! (echo "$agg_body" | grep -q '"success":true' || \
                echo "$agg_body" | grep -q '"public_key"' || \
                echo "$agg_body" | grep -q '"aggregated_pubkey"' || \
                echo "$agg_body" | grep -q '"threshold_pubkey"'); then
            success=0
            error_msg="Key aggregation returned invalid JSON (HTTP 200)"
            if [ "$DEBUG" -eq 1 ]; then
                echo "=== DEBUG: User $user_num Aggregation Invalid JSON ===" >> "$debug_file"
                echo "HTTP Code: $agg_code" >> "$debug_file"
                echo "Response Body: $agg_body" >> "$debug_file"
            fi
        fi
    fi
    
    # Operation 3: Sign message (2-step process)
    if [ "$success" -eq 1 ]; then
        local message_hash=$(echo -n "load test $user_num" | shasum -a 256 | cut -d' ' -f1)
        
        # Step 1: Send step 1
        local sign1_response=$(curl -s -w "\n%{http_code}" -X POST "$BASE_URL/agg-send-step1" \
            -H "Content-Type: application/json" \
            -d "{\"user_id\":\"$user_id\",\"message_hash\":\"$message_hash\",\"transaction_data\":\"test\"}" 2>/dev/null || echo -e "\n000")
        
        local sign1_body=$(echo "$sign1_response" | sed $d)
        local sign1_code=$(echo "$sign1_response" | tail -n 1)
        
        if [ "$sign1_code" != "200" ]; then
            success=0
            error_msg="Signing step 1 failed (HTTP $sign1_code)"
            if [ "$DEBUG" -eq 1 ]; then
                echo "=== DEBUG: User $user_num Signing Step 1 Failed ===" >> "$debug_file"
                echo "HTTP Code: $sign1_code" >> "$debug_file"
                echo "Response Body: $sign1_body" >> "$debug_file"
            fi
        elif ! (echo "$sign1_body" | grep -q '"success":true' || \
                echo "$sign1_body" | grep -q '"partial_sig"' || \
                echo "$sign1_body" | grep -q '"commitment"' || \
                echo "$sign1_body" | grep -q '"session_id"'); then
            success=0
            error_msg="Signing step 1 returned invalid JSON (HTTP 200)"
            if [ "$DEBUG" -eq 1 ]; then
                echo "=== DEBUG: User $user_num Signing Step 1 Invalid JSON ===" >> "$debug_file"
                echo "HTTP Code: $sign1_code" >> "$debug_file"
                echo "Response Body: $sign1_body" >> "$debug_file"
            fi
        fi
        
        # Step 2: Send step 2
        if [ "$success" -eq 1 ]; then
            local sign2_response=$(curl -s -w "\n%{http_code}" -X POST "$BASE_URL/agg-send-step2" \
                -H "Content-Type: application/json" \
                -d "{\"user_id\":\"$user_id\",\"message_hash\":\"$message_hash\",\"transaction_data\":\"test\"}" 2>/dev/null || echo -e "\n000")
            
            local sign2_body=$(echo "$sign2_response" | sed $d)
            local sign2_code=$(echo "$sign2_response" | tail -n 1)
            
            if [ "$sign2_code" != "200" ]; then
                success=0
                error_msg="Signing step 2 failed (HTTP $sign2_code)"
                if [ "$DEBUG" -eq 1 ]; then
                    echo "=== DEBUG: User $user_num Signing Step 2 Failed ===" >> "$debug_file"
                    echo "HTTP Code: $sign2_code" >> "$debug_file"
                    echo "Response Body: $sign2_body" >> "$debug_file"
                fi
            elif ! (echo "$sign2_body" | grep -q '"success":true' || \
                    echo "$sign2_body" | grep -q '"signature"' || \
                    echo "$sign2_body" | grep -q '"final_sig"' || \
                    echo "$sign2_body" | grep -q '"combined_signature"'); then
                success=0
                error_msg="Signing step 2 returned invalid JSON (HTTP 200)"
                if [ "$DEBUG" -eq 1 ]; then
                    echo "=== DEBUG: User $user_num Signing Step 2 Invalid JSON ===" >> "$debug_file"
                    echo "HTTP Code: $sign2_code" >> "$debug_file"
                    echo "Response Body: $sign2_body" >> "$debug_file"
                fi
            fi
        fi
    fi
    
    local end_time=$(get_millis)
    local duration=$((end_time - start_time))
    
    # Ensure duration is non-negative
    if [ "$duration" -lt 0 ]; then
        duration=0
    fi
    
    # Save results: success,duration,error_msg
    echo "$success,$duration,$error_msg" > "$results_file"
}

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}Starting load test with $CONCURRENT_USERS concurrent users...${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Start time
TEST_START=$(get_millis)

# Launch concurrent users
echo "Launching users..."
for i in $(seq 1 "$CONCURRENT_USERS"); do
    user_operations "$i" &
    
    # Progress indicator
    if [ $((i % 10)) -eq 0 ]; then
        echo -ne "\rLaunched $i/$CONCURRENT_USERS users..."
    fi
done
echo -ne "\rLaunched $CONCURRENT_USERS/$CONCURRENT_USERS users... ✓\n"

echo "Waiting for all operations to complete..."
wait

# End time
TEST_END=$(get_millis)
TEST_DURATION_MS=$((TEST_END - TEST_START))
TEST_DURATION_SEC=$((TEST_DURATION_MS / 1000))

# Prevent division by zero
if [ "$TEST_DURATION_MS" -eq 0 ]; then
    TEST_DURATION_MS=1
fi
if [ "$TEST_DURATION_SEC" -eq 0 ]; then
    TEST_DURATION_SEC=1
fi

echo ""
echo -e "${BLUE}Analyzing results...${NC}"

# Analyze results
SUCCESSFUL_USERS=0
FAILED_USERS=0
TOTAL_DURATION=0
MIN_DURATION=999999999
MAX_DURATION=0

# Arrays to store individual durations for percentile calculation
declare -a DURATIONS=()

# Track debug output
DEBUG_SHOWN=0

for i in $(seq 1 "$CONCURRENT_USERS"); do
    results_file="$TEMP_DIR/user_${i}.result"
    debug_file="$TEMP_DIR/user_${i}.debug"
    
    if [ -f "$results_file" ]; then
        result=$(cat "$results_file")
        success=$(echo "$result" | cut -d',' -f1)
        duration=$(echo "$result" | cut -d',' -f2)
        error_msg=$(echo "$result" | cut -d',' -f3)
        
        # Validate duration is a number
        if ! [[ "$duration" =~ ^[0-9]+$ ]]; then
            duration=0
        fi
        
        if [ "$success" = "1" ]; then
            SUCCESSFUL_USERS=$((SUCCESSFUL_USERS + 1))
            TOTAL_DURATION=$((TOTAL_DURATION + duration))
            DURATIONS+=("$duration")
            
            if [ "$duration" -lt "$MIN_DURATION" ]; then
                MIN_DURATION=$duration
            fi
            if [ "$duration" -gt "$MAX_DURATION" ]; then
                MAX_DURATION=$duration
            fi
        else
            FAILED_USERS=$((FAILED_USERS + 1))
            if [ -n "$error_msg" ] && [ "$FAILED_USERS" -le 5 ]; then
                echo -e "${RED}  User $i failed: $error_msg${NC}"
            fi
            
            # Show debug info for first 3 failures if DEBUG mode or if all failing
            if [ "$DEBUG" -eq 1 ] && [ "$DEBUG_SHOWN" -lt 3 ] && [ -f "$debug_file" ]; then
                echo -e "${YELLOW}=== Debug Output for User $i ===${NC}"
                cat "$debug_file"
                echo ""
                DEBUG_SHOWN=$((DEBUG_SHOWN + 1))
            fi
        fi
    else
        FAILED_USERS=$((FAILED_USERS + 1))
        if [ "$FAILED_USERS" -le 5 ]; then
            echo -e "${RED}  User $i: No result file found${NC}"
        fi
    fi
done

# If more than 5 failures, show summary
if [ "$FAILED_USERS" -gt 5 ]; then
    echo -e "${YELLOW}  ... and $((FAILED_USERS - 5)) more failures${NC}"
fi

# Calculate statistics
if [ "$SUCCESSFUL_USERS" -gt 0 ]; then
    AVG_DURATION=$((TOTAL_DURATION / SUCCESSFUL_USERS))
    
    # Calculate median (50th percentile)
    if [ ${#DURATIONS[@]} -gt 0 ]; then
        IFS=$'\n' SORTED_DURATIONS=($(sort -n <<<"${DURATIONS[*]}"))
        unset IFS
        MEDIAN_IDX=$((${#SORTED_DURATIONS[@]} / 2))
        MEDIAN_DURATION=${SORTED_DURATIONS[$MEDIAN_IDX]}
        
        # 95th percentile
        P95_IDX=$(( ${#SORTED_DURATIONS[@]} * 95 / 100 ))
        P95_DURATION=${SORTED_DURATIONS[$P95_IDX]}
    else
        MEDIAN_DURATION=0
        P95_DURATION=0
    fi
else
    AVG_DURATION=0
    MEDIAN_DURATION=0
    P95_DURATION=0
    MIN_DURATION=0
    MAX_DURATION=0
fi

# Calculate success rate (ensure no division by zero)
if [ "$CONCURRENT_USERS" -gt 0 ]; then
    SUCCESS_RATE=$((SUCCESSFUL_USERS * 100 / CONCURRENT_USERS))
else
    SUCCESS_RATE=0
fi

# Calculate throughput (operations per second)
TOTAL_SUCCESSFUL_OPS=$((SUCCESSFUL_USERS * OPERATIONS_PER_USER))
if [ "$TEST_DURATION_MS" -gt 0 ]; then
    # ops/sec = (total_ops * 1000) / duration_ms
    THROUGHPUT=$((TOTAL_SUCCESSFUL_OPS * 1000 / TEST_DURATION_MS))
else
    THROUGHPUT=0
fi

# Display Results
echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}📊 LOAD TEST RESULTS${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""
echo -e "${YELLOW}Test Configuration:${NC}"
echo -e "  Concurrent Users:    ${BLUE}$CONCURRENT_USERS${NC}"
echo -e "  Operations/User:     ${BLUE}$OPERATIONS_PER_USER${NC}"
echo -e "  Total Duration:      ${BLUE}${TEST_DURATION_SEC}s (${TEST_DURATION_MS}ms)${NC}"
echo ""
echo -e "${YELLOW}Results Summary:${NC}"
echo -e "  Successful Users:    ${GREEN}$SUCCESSFUL_USERS${NC}"
echo -e "  Failed Users:        ${RED}$FAILED_USERS${NC}"
echo -e "  Success Rate:        $([ "$SUCCESS_RATE" -ge 95 ] && echo -e "${GREEN}" || echo -e "${YELLOW}")${SUCCESS_RATE}%${NC}"
echo -e "  Total Operations:    ${BLUE}$TOTAL_SUCCESSFUL_OPS successful${NC}"
echo -e "  Throughput:          ${GREEN}~$THROUGHPUT ops/sec${NC}"
echo ""
echo -e "${YELLOW}⏱️  Response Times (ms):${NC}"
if [ "$SUCCESSFUL_USERS" -gt 0 ]; then
    echo -e "  Minimum:             ${BLUE}$MIN_DURATION ms${NC}"
    echo -e "  Average:             ${BLUE}$AVG_DURATION ms${NC}"
    echo -e "  Median (p50):        ${BLUE}$MEDIAN_DURATION ms${NC}"
    echo -e "  95th Percentile:     ${BLUE}$P95_DURATION ms${NC}"
    echo -e "  Maximum:             ${BLUE}$MAX_DURATION ms${NC}"
else
    echo -e "  ${RED}No successful operations to measure${NC}"
fi

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}✅ Success Criteria Validation${NC}"
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

CRITERIA_PASSED=0
CRITERIA_TOTAL=4

# Criterion 1: Success rate >= 95%
if [ "$SUCCESS_RATE" -ge 95 ]; then
    echo -e "${GREEN}✅ Success rate >= 95% (actual: ${SUCCESS_RATE}%)${NC}"
    CRITERIA_PASSED=$((CRITERIA_PASSED + 1))
else
    echo -e "${RED}❌ Success rate < 95% (actual: ${SUCCESS_RATE}%)${NC}"
fi

# Criterion 2: Average response time <= 5s
if [ "$AVG_DURATION" -le 5000 ]; then
    echo -e "${GREEN}✅ Average response time <= 5s (actual: ${AVG_DURATION}ms)${NC}"
    CRITERIA_PASSED=$((CRITERIA_PASSED + 1))
else
    echo -e "${RED}❌ Average response time > 5s (actual: ${AVG_DURATION}ms)${NC}"
fi

# Criterion 3: 95th percentile <= 10s
if [ "$P95_DURATION" -le 10000 ]; then
    echo -e "${GREEN}✅ 95th percentile <= 10s (actual: ${P95_DURATION}ms)${NC}"
    CRITERIA_PASSED=$((CRITERIA_PASSED + 1))
else
    echo -e "${RED}❌ 95th percentile > 10s (actual: ${P95_DURATION}ms)${NC}"
fi

# Criterion 4: At least 90% of users succeeded
MIN_SUCCESSFUL=$((CONCURRENT_USERS * 90 / 100))
if [ "$SUCCESSFUL_USERS" -ge "$MIN_SUCCESSFUL" ]; then
    echo -e "${GREEN}✅ Handled concurrent load successfully (>= 90% success)${NC}"
    CRITERIA_PASSED=$((CRITERIA_PASSED + 1))
else
    echo -e "${RED}❌ Failed to handle concurrent load (< 90% success)${NC}"
fi

echo ""
echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"

# Final verdict
if [ "$CRITERIA_PASSED" -eq "$CRITERIA_TOTAL" ]; then
    echo -e "${GREEN}🎉 ALL CRITERIA PASSED! ($CRITERIA_PASSED/$CRITERIA_TOTAL)${NC}"
    echo "The MPC system is ready for production-level load."
    EXIT_CODE=0
elif [ "$CRITERIA_PASSED" -ge $((CRITERIA_TOTAL * 3 / 4)) ]; then
    echo -e "${YELLOW}⚠️  PARTIAL PASS ($CRITERIA_PASSED/$CRITERIA_TOTAL criteria met)${NC}"
    echo "The MPC system shows good performance but has room for improvement."
    EXIT_CODE=0
else
    echo -e "${RED}❌ LOAD TEST FAILED ($CRITERIA_PASSED/$CRITERIA_TOTAL criteria met)${NC}"
    echo "The MPC system needs optimization before production use."
    EXIT_CODE=1
fi

echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

exit $EXIT_CODE