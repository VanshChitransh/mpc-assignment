use crate::AppState;
use crate::blockchain::{SolanaBlockchain, Transaction};
use crate::middleware::AuthExtensions;
use crate::models::api_response::{ApiResponse, error_codes};
use actix_web::{web, HttpRequest, HttpResponse, Result};
use serde::{Deserialize, Serialize};
use tracing::{error, info, warn};
use uuid::Uuid;
use prometheus::{Counter, Histogram, Registry};
use prometheus::HistogramOpts;use lazy_static::lazy_static;

// Prometheus metrics
lazy_static! {
    static ref SOLANA_TRANSACTIONS_TOTAL: Counter = Counter::new(
        "solana_transactions_total",
        "Total number of Solana transactions processed"
    ).unwrap();
    
    static ref SOLANA_TRANSACTION_FAILURES_TOTAL: Counter = Counter::new(
        "solana_transaction_failures_total",
        "Total number of failed Solana transactions"
    ).unwrap();
    
    static ref SOLANA_RPC_LATENCY_SECONDS: Histogram = Histogram::with_opts(HistogramOpts::new("solana_rpc_latency_seconds", "Solana RPC call latency in seconds").unwrap()
    ).unwrap();
}

// Address endpoint structures
#[derive(Deserialize)]
pub struct DeriveAddressRequest {
    pub public_key: String,
}

#[derive(Serialize)]
pub struct DeriveAddressResponse {
    pub address: String,
}

// Transfer endpoint structures
#[derive(Deserialize)]
pub struct TransferRequest {
    pub to_address: String,
    pub lamports: u64,
}

#[derive(Serialize)]
pub struct TransferResponse {
    pub transaction_signature: String,
    pub status: String,
}

/// POST /api/v1/solana/address - Derive Solana address from user's MPC public key
pub async fn derive_address(
    data: web::Data<AppState>,
    req: HttpRequest,
    req_body: web::Json<DeriveAddressRequest>,
) -> Result<HttpResponse> {
    let user_id = match req.get_user_id() {
        Some(id) => id,
        None => {
            error!("No user ID found in authenticated request");
            let api_response: ApiResponse<DeriveAddressResponse> = ApiResponse::error(
                error_codes::AUTHENTICATION_ERROR,
                "Authentication required"
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::UNAUTHORIZED));
        }
    };
    
    let address_req = req_body.into_inner();
    info!("Deriving Solana address for user {} from public key", user_id);
    
    // Derive Solana address from public key
    match SolanaBlockchain::derive_solana_address(&address_req.public_key) {
        Ok(address) => {
            info!("Successfully derived Solana address for user {}: {}", user_id, address);
            let api_response = ApiResponse::success(DeriveAddressResponse {
                address,
            });
            Ok(api_response.to_http_response(actix_web::http::StatusCode::OK))
        }
        Err(e) => {
            error!("Failed to derive Solana address for user {}: {}", user_id, e);
            let api_response: ApiResponse<DeriveAddressResponse> = ApiResponse::error(
                error_codes::VALIDATION_ERROR,
                &format!("Invalid public key: {}", e)
            );
            Ok(api_response.to_http_response(actix_web::http::StatusCode::BAD_REQUEST))
        }
    }
}

/// POST /api/v1/solana/transfer - Build, sign (via MPC), and send a Solana transaction
pub async fn transfer(
    data: web::Data<AppState>,
    req: HttpRequest,
    req_body: web::Json<TransferRequest>,
) -> Result<HttpResponse> {
    let user_id = match req.get_user_id() {
        Some(id) => id,
        None => {
            error!("No user ID found in authenticated request");
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::AUTHENTICATION_ERROR,
                "Authentication required"
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::UNAUTHORIZED));
        }
    };
    
    let transfer_req = req_body.into_inner();
    info!("Processing transfer request for user {}: {} lamports to {}", 
          user_id, transfer_req.lamports, transfer_req.to_address);
    
    // Start metrics timer
    let timer = SOLANA_RPC_LATENCY_SECONDS.start_timer();
    
    // Validate recipient address
    if !data.solana_blockchain.validate_address(&transfer_req.to_address) {
        warn!("Invalid recipient address for user {}: {}", user_id, transfer_req.to_address);
        SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
        let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
            error_codes::VALIDATION_ERROR,
            "Invalid recipient address format"
        );
        return Ok(api_response.to_http_response(actix_web::http::StatusCode::BAD_REQUEST));
    }
    
    // Get user's public key from MPC
    let user_public_key = match data.store.get_user_public_key(&user_id).await {
        Ok(Some(key)) => key,
        Ok(None) => {
            error!("No MPC key found for user {}", user_id);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::WALLET_ERROR,
                "User wallet not initialized. Please generate keys first."
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::BAD_REQUEST));
        }
        Err(e) => {
            error!("Failed to get user public key: {}", e);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::INTERNAL_ERROR,
                "Failed to retrieve user wallet"
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::INTERNAL_SERVER_ERROR));
        }
    };
    
    // Derive from address from public key
    let from_address = match SolanaBlockchain::derive_solana_address(&user_public_key) {
        Ok(addr) => addr,
        Err(e) => {
            error!("Failed to derive from address for user {}: {}", user_id, e);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::WALLET_ERROR,
                &format!("Failed to derive sender address: {}", e)
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::INTERNAL_SERVER_ERROR));
        }
    };
    
    // Get recent blockhash
    let recent_blockhash = match data.solana_blockchain.get_recent_blockhash().await {
        Ok(hash) => hash,
        Err(e) => {
            error!("Failed to get recent blockhash: {}", e);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::SERVICE_UNAVAILABLE,
                "Failed to connect to Solana network"
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::SERVICE_UNAVAILABLE));
        }
    };
    
    // Build transaction
    let unsigned_tx = match data.solana_blockchain.build_transaction(
        &from_address,
        &transfer_req.to_address,
        transfer_req.lamports,
        &recent_blockhash,
    ).await {
        Ok(tx) => tx,
        Err(e) => {
            error!("Failed to build transaction for user {}: {}", user_id, e);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::INTERNAL_ERROR,
                &format!("Failed to build transaction: {}", e)
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::INTERNAL_SERVER_ERROR));
        }
    };
    
    // Sign transaction with MPC
    // First, serialize transaction message for signing
    let message_bytes = match bincode::serialize(&unsigned_tx.message) {
        Ok(bytes) => bytes,
        Err(e) => {
            error!("Failed to serialize transaction message: {}", e);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::INTERNAL_ERROR,
                "Failed to prepare transaction for signing"
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::INTERNAL_SERVER_ERROR));
        }
    };
    
    let message_hash = hex::encode(&message_bytes);
    
    // Call MPC to sign
    let mpc_signature = match data.mpc_client.sign_transaction(
        &user_id,
        &message_hash,
        &message_hash, // transaction data
    ).await {
        Ok(sig) => sig,
        Err(e) => {
            error!("MPC signing failed for user {}: {}", user_id, e);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::SERVICE_UNAVAILABLE,
                "Transaction signing service temporarily unavailable"
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::SERVICE_UNAVAILABLE));
        }
    };
    
    // Sign the transaction
    let signed_tx = match data.solana_blockchain.sign_transaction(unsigned_tx, &mpc_signature) {
        Ok(tx) => tx,
        Err(e) => {
            error!("Failed to sign transaction for user {}: {}", user_id, e);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::INTERNAL_ERROR,
                &format!("Failed to sign transaction: {}", e)
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::INTERNAL_SERVER_ERROR));
        }
    };
    
    // Send transaction to Solana network
    let signature = match data.solana_blockchain.send_transaction(signed_tx).await {
        Ok(sig) => sig,
        Err(e) => {
            error!("Failed to send transaction for user {}: {}", user_id, e);
            SOLANA_TRANSACTION_FAILURES_TOTAL.inc();
            let api_response: ApiResponse<TransferResponse> = ApiResponse::error(
                error_codes::INTERNAL_ERROR,
                &format!("Failed to broadcast transaction: {}", e)
            );
            return Ok(api_response.to_http_response(actix_web::http::StatusCode::INTERNAL_SERVER_ERROR));
        }
    };
    
    // Stop timer and record metrics
    timer.observe_duration();
    SOLANA_TRANSACTIONS_TOTAL.inc();
    
    info!("Successfully processed transfer for user {}: signature {}", user_id, signature);
    
    let api_response = ApiResponse::success(TransferResponse {
        transaction_signature: signature,
        status: "pending".to_string(),
    });
    Ok(api_response.to_http_response(actix_web::http::StatusCode::OK))
}

/// Register Solana v1 API routes
pub fn config(cfg: &mut web::ServiceConfig) {
    cfg.service(
        web::scope("/v1/solana")
            .route("/address", web::post().to(derive_address))
            .route("/transfer", web::post().to(transfer))
    );
}

/// Initialize Prometheus metrics
pub fn init_metrics(registry: &Registry) -> Result<(), prometheus::Error> {
    registry.register(Box::new(SOLANA_TRANSACTIONS_TOTAL.clone()))?;
    registry.register(Box::new(SOLANA_TRANSACTION_FAILURES_TOTAL.clone()))?;
    registry.register(Box::new(SOLANA_RPC_LATENCY_SECONDS.clone()))?;
    Ok(())
}
