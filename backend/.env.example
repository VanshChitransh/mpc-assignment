# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solana_wallet

# JWT Secret (min 32 characters)
JWT_SECRET=your-secret-key-change-in-production-min-32-chars-long

# MPC Nodes
MPC_NODE_1_URL=http://localhost:8001
MPC_NODE_2_URL=http://localhost:8002
MPC_NODE_3_URL=http://localhost:8003

# Logging
RUST_LOG=info,backend=debug