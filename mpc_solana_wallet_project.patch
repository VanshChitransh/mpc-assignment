+    
+    if echo "$BALANCE_RESULT" | grep -q "balances"; then
+        echo -e "${GREEN}✓ Balance endpoint successful${NC}"
+        echo "$BALANCE_RESULT" | jq '.balances[] | {mint, symbol, ui_amount}'
+        return 0
+    else
+        echo -e "${RED}✗ Balance endpoint failed${NC}"
+        echo "$BALANCE_RESULT" | jq
+        return 1
+    fi
+}
+
