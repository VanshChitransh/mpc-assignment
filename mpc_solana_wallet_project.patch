+            .post(&self.rpc_url)
+            .json(&request_body)
+            .send()
+            .await?;
+        
+        let balance_response: BalanceResponse = response.json().await?;
+        
+        if let Some(error) = balance_response.error {
+            return Err(SolanaError::RpcError(format!("RPC error: {} - {}", error.code, error.message)));
+        }
+        
